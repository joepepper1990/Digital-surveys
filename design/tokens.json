{
  "$schema": "./tokens.schema.json",
  "tokenSetId": "esg-field-2026",
  "description": "Single source of truth for the application design system (directive §8). Nothing in the app hard-codes a colour, spacing value, radius, height or type size — every control reads a token. design/emit_powerfx.py renders this file as Power Fx named formulas for App.Formulas.",

  "character": {
    "intent": "High-end engineering application. Light working surfaces for plant lighting and gloved use, a deep slate command bar for identity and orientation, one confident action colour, and semantic status colours used sparingly so they still mean something.",
    "avoid": ["default Power Apps styling", "gradients", "decorative gauges", "animated hazard iconography", "dense spreadsheet entry grids"]
  },

  "color": {
    "backgroundPage":     { "hex": "#F4F6F8", "role": "app canvas behind all cards" },
    "surface":            { "hex": "#FFFFFF", "role": "card and panel background" },
    "surfaceRaised":      { "hex": "#FFFFFF", "role": "modal and popover background" },
    "surfaceMuted":       { "hex": "#EDF1F5", "role": "inactive / not-due / disabled surface" },
    "surfaceInset":       { "hex": "#F8FAFB", "role": "input wells and read-only blocks" },
    "commandBar":         { "hex": "#10202E", "role": "top application bar" },
    "commandBarInk":      { "hex": "#F2F6F9", "role": "text on the command bar" },
    "commandBarInkMuted": { "hex": "#A9BBC9", "role": "secondary text on the command bar" },

    "inkPrimary":   { "hex": "#0F1A24", "role": "primary text" },
    "inkSecondary": { "hex": "#43566A", "role": "secondary text and labels" },
    "inkMuted":     { "hex": "#5E7286", "role": "hint and metadata text" },
    "inkInverse":   { "hex": "#FFFFFF", "role": "text on strong fills" },

    "actionPrimary":        { "hex": "#00558C", "role": "primary action fill" },
    "actionPrimaryHover":   { "hex": "#004474", "role": "primary action hover" },
    "actionPrimaryPressed": { "hex": "#00365C", "role": "primary action pressed" },
    "actionSecondaryInk":   { "hex": "#00558C", "role": "secondary action text and border" },

    "successInk":     { "hex": "#136A40", "role": "valid / complete" },
    "successSurface": { "hex": "#E4F3EA", "role": "valid / complete background" },
    "warningInk":     { "hex": "#8A4B00", "role": "outstanding action / deferred" },
    "warningSurface": { "hex": "#FBEFDF", "role": "outstanding action background" },
    "criticalInk":    { "hex": "#A21D16", "role": "expired calibration, failed check, not surveyed" },
    "criticalSurface":{ "hex": "#FBE8E6", "role": "critical background" },
    "infoInk":        { "hex": "#0E5480", "role": "informational / in progress" },
    "infoSurface":    { "hex": "#E5F0F7", "role": "informational background" },

    "disabledSurface": { "hex": "#E3E9EE", "role": "disabled control fill" },
    "disabledInk":     { "hex": "#55616C", "role": "disabled control text — kept above 4.5:1 so a disabled control is still legible, not just faint (§45)" },

    "border":     { "hex": "#C9D3DB", "role": "control and card border" },
    "divider":    { "hex": "#E2E8ED", "role": "hairline separators" },
    "focusRing":  { "hex": "#0072CE", "role": "keyboard and stylus focus indicator" },
    "hazardInk":  { "hex": "#6B2D8F", "role": "known condition / hotspot indicator, deliberately distinct from the status ramp" },
    "hazardSurface": { "hex": "#F1E8F7", "role": "known condition background" }
  },

  "contrastPairs": [
    { "ink": "inkPrimary",        "on": "backgroundPage",  "minRatio": 4.5 },
    { "ink": "inkPrimary",        "on": "surface",         "minRatio": 4.5 },
    { "ink": "inkPrimary",        "on": "surfaceMuted",    "minRatio": 4.5 },
    { "ink": "inkPrimary",        "on": "surfaceInset",    "minRatio": 4.5 },
    { "ink": "inkSecondary",      "on": "surface",         "minRatio": 4.5 },
    { "ink": "inkMuted",          "on": "surface",         "minRatio": 4.5 },
    { "ink": "commandBarInk",     "on": "commandBar",      "minRatio": 4.5 },
    { "ink": "commandBarInkMuted","on": "commandBar",      "minRatio": 4.5 },
    { "ink": "inkInverse",        "on": "actionPrimary",   "minRatio": 4.5 },
    { "ink": "inkInverse",        "on": "actionPrimaryHover",   "minRatio": 4.5 },
    { "ink": "inkInverse",        "on": "actionPrimaryPressed", "minRatio": 4.5 },
    { "ink": "actionSecondaryInk","on": "surface",         "minRatio": 4.5 },
    { "ink": "successInk",        "on": "successSurface",  "minRatio": 4.5 },
    { "ink": "successInk",        "on": "surface",         "minRatio": 4.5 },
    { "ink": "warningInk",        "on": "warningSurface",  "minRatio": 4.5 },
    { "ink": "warningInk",        "on": "surface",         "minRatio": 4.5 },
    { "ink": "criticalInk",       "on": "criticalSurface", "minRatio": 4.5 },
    { "ink": "criticalInk",       "on": "surface",         "minRatio": 4.5 },
    { "ink": "infoInk",           "on": "infoSurface",     "minRatio": 4.5 },
    { "ink": "infoInk",           "on": "surface",         "minRatio": 4.5 },
    { "ink": "hazardInk",         "on": "hazardSurface",   "minRatio": 4.5 },
    { "ink": "disabledInk",       "on": "disabledSurface", "minRatio": 4.5 }
  ],

  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48, "section": 64 },

  "radius": { "none": 0, "sm": 4, "md": 8, "lg": 12, "xl": 16, "pill": 999 },

  "elevation": {
    "approach": "Canvas has no true shadow primitive on most controls. Elevation is expressed as a 1px border plus, for modals only, a full-screen scrim rectangle at 55% black. Do not simulate shadows with stacked offset rectangles — they misalign at different zoom levels and add controls to the screen budget.",
    "scrimOpacity": 0.55,
    "levels": {
      "flat":   { "border": "divider" },
      "card":   { "border": "border" },
      "modal":  { "border": "border", "scrim": true }
    }
  },

  "size": {
    "minTouchTarget": 48,
    "fieldHeight": 56,
    "buttonHeight": 56,
    "buttonHeightLarge": 64,
    "commandBarHeight": 72,
    "sectionHeaderHeight": 56,
    "capabilityCardMinHeight": 200,
    "pointRowHeight": 88,
    "statusBadgeHeight": 32,
    "iconSize": 24,
    "borderWidth": 1,
    "borderWidthStrong": 2,
    "focusRingWidth": 3
  },

  "typography": {
    "family": "Segoe UI",
    "familyFallback": "Open Sans",
    "scale": {
      "display":    { "size": 40, "weight": "Semibold", "role": "survey card headline" },
      "heading1":   { "size": 30, "weight": "Semibold", "role": "screen title" },
      "heading2":   { "size": 24, "weight": "Semibold", "role": "card title" },
      "heading3":   { "size": 20, "weight": "Semibold", "role": "section heading within a card" },
      "bodyLarge":  { "size": 18, "weight": "Normal",   "role": "measurement values and primary readable text" },
      "body":       { "size": 16, "weight": "Normal",   "role": "default body text — the floor for anything a technician reads in plant" },
      "bodyStrong": { "size": 16, "weight": "Semibold", "role": "field labels and emphasis" },
      "caption":    { "size": 14, "weight": "Semibold", "role": "status badges and units" },
      "numeric":    { "size": 28, "weight": "Semibold", "role": "numeric measurement entry — deliberately large (§29)" }
    },
    "minimumReadableSize": 14
  },

  "statusStyles": {
    "_comment": "Directive §16 and §26: status is never carried by colour alone. Every status declares an ink token, a surface token, a glyph and a text label, and all four are rendered.",
    "notSelected":   { "ink": "inkMuted",     "surface": "surfaceMuted",    "glyph": "○", "label": "Not selected" },
    "incomplete":    { "ink": "warningInk",   "surface": "warningSurface",  "glyph": "◑", "label": "Details incomplete" },
    "valid":         { "ink": "successInk",   "surface": "successSurface",  "glyph": "✓", "label": "Valid" },
    "calExpired":    { "ink": "criticalInk",  "surface": "criticalSurface", "glyph": "✕", "label": "Calibration expired" },
    "preUseFailed":  { "ink": "criticalInk",  "surface": "criticalSurface", "glyph": "✕", "label": "Pre-use failed" },
    "backgroundDue": { "ink": "warningInk",   "surface": "warningSurface",  "glyph": "◑", "label": "Background required" },
    "invalid":       { "ink": "criticalInk",  "surface": "criticalSurface", "glyph": "✕", "label": "Invalid capability" },

    "pointNotDue":     { "ink": "inkMuted",    "surface": "surfaceMuted",    "glyph": "–", "label": "Not due" },
    "pointDue":        { "ink": "inkPrimary",  "surface": "surface",         "glyph": "○", "label": "Due" },
    "pointInProgress": { "ink": "infoInk",     "surface": "infoSurface",     "glyph": "◐", "label": "In progress" },
    "pointComplete":   { "ink": "successInk",  "surface": "successSurface",  "glyph": "✓", "label": "Complete" },
    "pointAction":     { "ink": "warningInk",  "surface": "warningSurface",  "glyph": "!", "label": "Outstanding action" },
    "pointNotSurveyed":{ "ink": "criticalInk", "surface": "criticalSurface", "glyph": "✕", "label": "Not surveyed" },
    "knownCondition":  { "ink": "hazardInk",   "surface": "hazardSurface",   "glyph": "▲", "label": "Known condition" }
  },

  "syncStyles": {
    "_comment": "Directive §37: sync state is presented separately from workflow state, and never implies server-side persistence while offline.",
    "savedLocally": { "ink": "inkMuted",    "surface": "surfaceMuted", "glyph": "▪", "label": "Saved locally" },
    "pendingSync":  { "ink": "warningInk",  "surface": "warningSurface","glyph": "↑", "label": "Pending sync" },
    "syncing":      { "ink": "infoInk",     "surface": "infoSurface",  "glyph": "↻", "label": "Syncing" },
    "synced":       { "ink": "successInk",  "surface": "successSurface","glyph": "✓", "label": "Synced" },
    "syncError":    { "ink": "criticalInk", "surface": "criticalSurface","glyph": "!", "label": "Sync error" }
  }
}
