{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedsharepointonline_1to1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedoffice365_1to1"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ESG 1-to-1 Site URL (esg_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_SiteUrl",
            "description": "Full address of the private 1-to-1 site, e.g. https://<tenant>.sharepoint.com/sites/<site> (no trailing slash)."
          }
        },
        "ESG 1-to-1 Team Leader email (esg_ManagerEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_ManagerEmail",
            "description": "The Team Leader's email address. Receives submissions and problem reports."
          }
        }
      },
      "triggers": {
        "When_a_monthly_review_is_created_or_modified": {
          "type": "OpenApiConnection",
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@not(contains(createArray('Not Started','Draft'), triggerBody()?['ReviewStatus']?['Value']))"
            }
          ],
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
              "table": "Monthly Reviews"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Get_owners_group": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/associatedownergroup?$select=Id,Title",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Get_role_definitions": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/roledefinitions?$select=Id,Name,RoleTypeKind",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_owners_group": [
                  "Succeeded"
                ]
              }
            },
            "Role_full_control": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['RoleTypeKind'], 5)"
              },
              "runAfter": {
                "Get_role_definitions": [
                  "Succeeded"
                ]
              }
            },
            "Role_edit": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Edit')"
              },
              "runAfter": {
                "Role_full_control": [
                  "Succeeded"
                ]
              }
            },
            "Role_read": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Read')"
              },
              "runAfter": {
                "Role_edit": [
                  "Succeeded"
                ]
              }
            },
            "Get_lists": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists?$select=Id,Title,RootFolder/Name&$expand=RootFolder",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Role_read": [
                  "Succeeded"
                ]
              }
            },
            "List_monthly_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'MonthlyReviews')"
              },
              "runAfter": {
                "Get_lists": [
                  "Succeeded"
                ]
              }
            },
            "List_manager_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'ManagerReviews')"
              },
              "runAfter": {
                "List_monthly_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Ids": {
              "type": "Compose",
              "inputs": {
                "owners": "@body('Get_owners_group')?['Id']",
                "fullControl": "@first(body('Role_full_control'))?['Id']",
                "edit": "@first(body('Role_edit'))?['Id']",
                "read": "@first(body('Role_read'))?['Id']",
                "reviewsList": "@first(body('List_monthly_reviews'))?['Id']",
                "mgrList": "@first(body('List_manager_reviews'))?['Id']"
              },
              "runAfter": {
                "List_manager_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Check_setup_has_run": {
              "type": "If",
              "expression": "@or(equals(outputs('Ids')?['owners'], null), equals(outputs('Ids')?['fullControl'], null), equals(outputs('Ids')?['edit'], null), equals(outputs('Ids')?['read'], null), equals(outputs('Ids')?['reviewsList'], null), equals(outputs('Ids')?['mgrList'], null))",
              "actions": {
                "STOP_run_the_setup_flow_first": {
                  "type": "Compose",
                  "inputs": "@int('The 1-to-1 permission levels or Owners group were not found. Run ESG 1-to-1 | 0 Setup first.')",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Ids": [
                  "Succeeded"
                ]
              }
            },
            "Find_mgr": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "table": "Manager Reviews",
                  "$filter": "ReviewItemId eq @{triggerBody()?['ID']}",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Check_setup_has_run": [
                  "Succeeded"
                ]
              }
            },
            "Unknown_item": {
              "type": "If",
              "expression": "@equals(length(body('Find_mgr')?['value']), 0)",
              "actions": {
                "Not_a_flow_review": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Cancelled"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Find_mgr": [
                  "Succeeded"
                ]
              }
            },
            "Mgr": {
              "type": "Compose",
              "inputs": "@first(body('Find_mgr')?['value'])",
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs"
                  ]
                }
              },
              "runAfter": {
                "Unknown_item": [
                  "Succeeded"
                ]
              }
            },
            "PrevState": {
              "type": "Compose",
              "inputs": "@outputs('Mgr')?['ReviewState']?['Value']",
              "runAfter": {
                "Mgr": [
                  "Succeeded"
                ]
              }
            },
            "Team_leader_amendment": {
              "type": "If",
              "expression": "@and(equals(toLower(coalesce(triggerBody()?['Editor']?['Email'], '')), toLower(parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)'))), not(equals(outputs('PrevState'), 'Open')))",
              "actions": {
                "Amendment_not_a_submission": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Cancelled"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "PrevState": [
                  "Succeeded"
                ]
              }
            },
            "Submitted_at": {
              "type": "Compose",
              "inputs": "@if(greater(ticks(coalesce(triggerBody()?['Modified'], '1900-01-01T00:00:00Z')), ticks(addMinutes(utcNow(), -30))), triggerBody()?['Modified'], utcNow())",
              "runAfter": {
                "Team_leader_amendment": [
                  "Succeeded"
                ]
              }
            },
            "Ensure_user": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/ensureuser",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"logonName\":\"@{outputs('Mgr')?['Technician']?['Claims']}\"}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Submitted_at": [
                  "Succeeded"
                ]
              }
            },
            "Reset": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{triggerBody()?['ID']})/resetroleinheritance",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Ensure_user": [
                  "Succeeded"
                ]
              }
            },
            "Break": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{triggerBody()?['ID']})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Reset": [
                  "Succeeded"
                ]
              }
            },
            "AddOwners": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{triggerBody()?['ID']})/roleassignments/addroleassignment(principalid=@{outputs('Ids')?['owners']},roledefid=@{outputs('Ids')?['fullControl']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Break": [
                  "Succeeded"
                ]
              }
            },
            "AddTech": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{triggerBody()?['ID']})/roleassignments/addroleassignment(principalid=@{body('Ensure_user')?['Id']},roledefid=@{outputs('Ids')?['read']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "AddOwners": [
                  "Succeeded"
                ]
              }
            },
            "First_submission": {
              "type": "If",
              "expression": "@equals(outputs('PrevState'), 'Open')",
              "actions": {
                "Stamp_submitted": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "table": "Manager Reviews",
                      "id": "@outputs('Mgr')?['ID']",
                      "item/Title": "@outputs('Mgr')?['Title']",
                      "item/ReviewState/Value": "Submitted",
                      "item/SubmittedOn": "@outputs('Submitted_at')",
                      "item/SubmittedLate": "@greater(ticks(outputs('Submitted_at')), ticks(outputs('Mgr')?['DueDate']))",
                      "item/TechFollowUp": "@coalesce(triggerBody()?['Q9FollowUp']?['Value'], '')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                },
                "Send_E3": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                      "emailMessage/Subject": "@{if(startsWith(coalesce(triggerBody()?['Q9FollowUp']?['Value'], ''), 'Arrange a dedicated'), '[1-to-1 REQUESTED] ', '')}1-to-1 submitted: @{outputs('Mgr')?['Title']}",
                      "emailMessage/Body": "<p>Submitted @{if(greater(ticks(outputs('Submitted_at')), ticks(outputs('Mgr')?['DueDate'])), 'late', 'on time')}. <a href=\"@{concat(concat(if(endsWith(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), '/'), substring(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), 0, sub(length(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), 1)), parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), '/SitePages/OneToOne.aspx'), if(empty(first(split(string(coalesce(triggerBody()?['ID'], '')), '.'))), '', concat('?reviewId=', first(split(string(coalesce(triggerBody()?['ID'], '')), '.')))))}\"><b>Open review</b></a></p>",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {
                    "Stamp_submitted": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "AddTech": [
                  "Succeeded"
                ]
              }
            },
            "Desired": {
              "type": "Compose",
              "inputs": "@if(equals(outputs('PrevState'), 'Open'), 'Submitted', outputs('PrevState'))",
              "runAfter": {
                "First_submission": [
                  "Succeeded"
                ]
              }
            },
            "Status_differs": {
              "type": "If",
              "expression": "@not(equals(triggerBody()?['ReviewStatus']?['Value'], outputs('Desired')))",
              "actions": {
                "Correct_status": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "table": "Monthly Reviews",
                      "id": "@triggerBody()?['ID']",
                      "item/Title": "@outputs('Mgr')?['Title']",
                      "item/ReviewStatus/Value": "@outputs('Desired')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Desired": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Email_TL_run_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                  "emailMessage/Subject": "@{concat('Submission received but LOCK FAILED – check Monthly Review ', string(triggerBody()?['ID']))}",
                  "emailMessage/Body": "<p>The flow <b>ESG 1-to-1 | 2 Review submitted</b> failed. Nothing further was sent for this run.</p><p><a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">Open the failed run</a></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {}
            },
            "Terminate_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ESG1to1",
                  "message": "The Try scope failed. See the failed action in the run history."
                }
              },
              "runAfter": {
                "Email_TL_run_failed": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
