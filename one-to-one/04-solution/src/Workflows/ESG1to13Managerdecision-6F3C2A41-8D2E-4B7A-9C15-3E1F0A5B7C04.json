{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedsharepointonline_1to1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedoffice365_1to1"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ESG 1-to-1 Site URL (esg_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_SiteUrl",
            "description": "Full address of the private 1-to-1 site, e.g. https://<tenant>.sharepoint.com/sites/<site> (no trailing slash)."
          }
        },
        "ESG 1-to-1 Team Leader email (esg_ManagerEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_ManagerEmail",
            "description": "The Team Leader's email address. Receives submissions and problem reports."
          }
        }
      },
      "triggers": {
        "When_a_manager_review_is_created_or_modified": {
          "type": "OpenApiConnection",
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@contains(createArray('Completed','Closed - Not Submitted'), triggerBody()?['ReviewState']?['Value'])"
            },
            {
              "expression": "@empty(triggerBody()?['ReleasedOn'])"
            }
          ],
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
              "table": "Manager Reviews"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Get_owners_group": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/associatedownergroup?$select=Id,Title",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Get_role_definitions": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/roledefinitions?$select=Id,Name,RoleTypeKind",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_owners_group": [
                  "Succeeded"
                ]
              }
            },
            "Role_full_control": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['RoleTypeKind'], 5)"
              },
              "runAfter": {
                "Get_role_definitions": [
                  "Succeeded"
                ]
              }
            },
            "Role_edit": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Edit')"
              },
              "runAfter": {
                "Role_full_control": [
                  "Succeeded"
                ]
              }
            },
            "Role_read": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Read')"
              },
              "runAfter": {
                "Role_edit": [
                  "Succeeded"
                ]
              }
            },
            "Get_lists": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists?$select=Id,Title,RootFolder/Name&$expand=RootFolder",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Role_read": [
                  "Succeeded"
                ]
              }
            },
            "List_monthly_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'MonthlyReviews')"
              },
              "runAfter": {
                "Get_lists": [
                  "Succeeded"
                ]
              }
            },
            "List_manager_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'ManagerReviews')"
              },
              "runAfter": {
                "List_monthly_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Ids": {
              "type": "Compose",
              "inputs": {
                "owners": "@body('Get_owners_group')?['Id']",
                "fullControl": "@first(body('Role_full_control'))?['Id']",
                "edit": "@first(body('Role_edit'))?['Id']",
                "read": "@first(body('Role_read'))?['Id']",
                "reviewsList": "@first(body('List_monthly_reviews'))?['Id']",
                "mgrList": "@first(body('List_manager_reviews'))?['Id']"
              },
              "runAfter": {
                "List_manager_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Check_setup_has_run": {
              "type": "If",
              "expression": "@or(equals(outputs('Ids')?['owners'], null), equals(outputs('Ids')?['fullControl'], null), equals(outputs('Ids')?['edit'], null), equals(outputs('Ids')?['read'], null), equals(outputs('Ids')?['reviewsList'], null), equals(outputs('Ids')?['mgrList'], null))",
              "actions": {
                "STOP_run_the_setup_flow_first": {
                  "type": "Compose",
                  "inputs": "@int('The 1-to-1 permission levels or Owners group were not found. Run ESG 1-to-1 | 0 Setup first.')",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Ids": [
                  "Succeeded"
                ]
              }
            },
            "Get_current": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "table": "Manager Reviews",
                  "$filter": "ID eq @{triggerBody()?['ID']}",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Check_setup_has_run": [
                  "Succeeded"
                ]
              }
            },
            "Already_released": {
              "type": "If",
              "expression": "@not(empty(first(body('Get_current')?['value'])?['ReleasedOn']))",
              "actions": {
                "Released_by_an_earlier_run": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Cancelled"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Get_current": [
                  "Succeeded"
                ]
              }
            },
            "Cmd": {
              "type": "Compose",
              "inputs": "@triggerBody()?['ReviewState']?['Value']",
              "runAfter": {
                "Already_released": [
                  "Succeeded"
                ]
              }
            },
            "Valid": {
              "type": "If",
              "expression": "@or(and(equals(outputs('Cmd'), 'Completed'), not(empty(triggerBody()?['SubmittedOn']))), and(equals(outputs('Cmd'), 'Closed - Not Submitted'), empty(triggerBody()?['SubmittedOn']), less(ticks(triggerBody()?['DueDate']), ticks(utcNow()))))",
              "actions": {},
              "else": {
                "actions": {
                  "Revert_state": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                        "table": "Manager Reviews",
                        "id": "@triggerBody()?['ID']",
                        "item/Title": "@triggerBody()?['Title']",
                        "item/ReviewState/Value": "@if(empty(triggerBody()?['SubmittedOn']), 'Open', 'Submitted')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {}
                  },
                  "Email_not_done": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                        "emailMessage/Subject": "1-to-1: not done",
                        "emailMessage/Body": "<p>You can only complete a submitted review, and only close one that hasn't been submitted after its deadline. (@{triggerBody()?['Title']})</p>",
                        "emailMessage/Importance": "Normal"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {
                      "Revert_state": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Stop_invalid": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Cancelled"
                    },
                    "runAfter": {
                      "Email_not_done": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Cmd": [
                  "Succeeded"
                ]
              }
            },
            "Ensure_user": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/ensureuser",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "{\"logonName\":\"@{triggerBody()?['Technician']?['Claims']}\"}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Valid": [
                  "Succeeded"
                ]
              }
            },
            "Has_monthly_review": {
              "type": "If",
              "expression": "@not(equals(triggerBody()?['ReviewItemId'], null))",
              "actions": {
                "Reset_R": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{int(first(split(string(coalesce(triggerBody()?['ReviewItemId'], '')), '.')))})/resetroleinheritance",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                },
                "Break_R": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{int(first(split(string(coalesce(triggerBody()?['ReviewItemId'], '')), '.')))})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {
                    "Reset_R": [
                      "Succeeded"
                    ]
                  }
                },
                "AddOwners_R": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{int(first(split(string(coalesce(triggerBody()?['ReviewItemId'], '')), '.')))})/roleassignments/addroleassignment(principalid=@{outputs('Ids')?['owners']},roledefid=@{outputs('Ids')?['fullControl']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {
                    "Break_R": [
                      "Succeeded"
                    ]
                  }
                },
                "AddTech_R": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['reviewsList']}')/items(@{int(first(split(string(coalesce(triggerBody()?['ReviewItemId'], '')), '.')))})/roleassignments/addroleassignment(principalid=@{body('Ensure_user')?['Id']},roledefid=@{outputs('Ids')?['read']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {
                    "AddOwners_R": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Ensure_user": [
                  "Succeeded"
                ]
              }
            },
            "Reset_M": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['mgrList']}')/items(@{triggerBody()?['ID']})/resetroleinheritance",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Has_monthly_review": [
                  "Succeeded"
                ]
              }
            },
            "Break_M": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['mgrList']}')/items(@{triggerBody()?['ID']})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Reset_M": [
                  "Succeeded"
                ]
              }
            },
            "AddOwners_M": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['mgrList']}')/items(@{triggerBody()?['ID']})/roleassignments/addroleassignment(principalid=@{outputs('Ids')?['owners']},roledefid=@{outputs('Ids')?['fullControl']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Break_M": [
                  "Succeeded"
                ]
              }
            },
            "AddTech_M": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('Ids')?['mgrList']}')/items(@{triggerBody()?['ID']})/roleassignments/addroleassignment(principalid=@{body('Ensure_user')?['Id']},roledefid=@{outputs('Ids')?['read']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "AddOwners_M": [
                  "Succeeded"
                ]
              }
            },
            "Stamp_released": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "table": "Manager Reviews",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/ReleasedOn": "@utcNow()",
                  "item/CompletedOn": "@utcNow()",
                  "item/CompletedBy": "@triggerBody()?['Editor']?['Email']"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "AddTech_M": [
                  "Succeeded"
                ]
              }
            },
            "Review_exists": {
              "type": "If",
              "expression": "@not(equals(triggerBody()?['ReviewItemId'], null))",
              "actions": {
                "Set_review_status": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "table": "Monthly Reviews",
                      "id": "@int(first(split(string(coalesce(triggerBody()?['ReviewItemId'], '')), '.')))",
                      "item/Title": "@triggerBody()?['Title']",
                      "item/ReviewStatus/Value": "@outputs('Cmd')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Stamp_released": [
                  "Succeeded"
                ]
              }
            },
            "Was_completed": {
              "type": "If",
              "expression": "@equals(outputs('Cmd'), 'Completed')",
              "actions": {
                "Send_E4": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@triggerBody()?['Technician']?['Email']",
