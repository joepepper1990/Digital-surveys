{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedsharepointonline_1to1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedoffice365_1to1"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ESG 1-to-1 Site URL (esg_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_SiteUrl",
            "description": "Full address of the private 1-to-1 site, e.g. https://<tenant>.sharepoint.com/sites/<site> (no trailing slash)."
          }
        },
        "ESG 1-to-1 Team Leader email (esg_ManagerEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_ManagerEmail",
            "description": "The Team Leader's email address. Receives submissions and problem reports."
          }
        }
      },
      "triggers": {
        "When_an_action_email_is_ready_to_send": {
          "type": "OpenApiConnection",
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@contains(createArray('Pending','Retry'), triggerBody()?['Status']?['Value'])"
            }
          ],
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            },
            "concurrency": {
              "runs": 1
            }
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
              "table": "1-to-1 Action Notices"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Get_owners_group": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/associatedownergroup?$select=Id,Title",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Get_role_definitions": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/roledefinitions?$select=Id,Name,RoleTypeKind",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_owners_group": [
                  "Succeeded"
                ]
              }
            },
            "Role_full_control": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['RoleTypeKind'], 5)"
              },
              "runAfter": {
                "Get_role_definitions": [
                  "Succeeded"
                ]
              }
            },
            "Role_edit": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Edit')"
              },
              "runAfter": {
                "Role_full_control": [
                  "Succeeded"
                ]
              }
            },
            "Role_read": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Read')"
              },
              "runAfter": {
                "Role_edit": [
                  "Succeeded"
                ]
              }
            },
            "Role_submit": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Submit')"
              },
              "runAfter": {
                "Role_read": [
                  "Succeeded"
                ]
              }
            },
            "Get_lists": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists?$select=Id,Title,ListItemEntityTypeFullName,RootFolder/Name,RootFolder/ServerRelativeUrl&$expand=RootFolder",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Role_submit": [
                  "Succeeded"
                ]
              }
            },
            "List_monthly_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'MonthlyReviews')"
              },
              "runAfter": {
                "Get_lists": [
                  "Succeeded"
                ]
              }
            },
            "List_manager_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'ManagerReviews')"
              },
              "runAfter": {
                "List_monthly_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Ids": {
              "type": "Compose",
              "inputs": {
                "owners": "@body('Get_owners_group')?['Id']",
                "fullControl": "@first(body('Role_full_control'))?['Id']",
                "edit": "@first(body('Role_edit'))?['Id']",
                "read": "@first(body('Role_read'))?['Id']",
                "submit": "@first(body('Role_submit'))?['Id']",
                "reviewsList": "@first(body('List_monthly_reviews'))?['Id']",
                "mgrList": "@first(body('List_manager_reviews'))?['Id']"
              },
              "runAfter": {
                "List_manager_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Check_setup_has_run": {
              "type": "If",
              "expression": "@or(equals(outputs('Ids')?['owners'], null), equals(outputs('Ids')?['fullControl'], null), equals(outputs('Ids')?['edit'], null), equals(outputs('Ids')?['read'], null), equals(outputs('Ids')?['reviewsList'], null), equals(outputs('Ids')?['mgrList'], null))",
              "actions": {
                "STOP_run_the_setup_flow_first": {
                  "type": "Compose",
                  "inputs": "@int('The 1-to-1 permission levels or Owners group were not found. Run ESG 1-to-1 | 0 Setup first.')",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Ids": [
                  "Succeeded"
                ]
              }
            },
            "List_actions": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'OneToOneActions')"
              },
              "runAfter": {
                "Check_setup_has_run": [
                  "Succeeded"
                ]
              }
            },
            "List_action_updates": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'OneToOneActionUpdates')"
              },
              "runAfter": {
                "List_actions": [
                  "Succeeded"
                ]
              }
            },
            "List_action_notices": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'OneToOneActionNotices')"
              },
              "runAfter": {
                "List_action_updates": [
                  "Succeeded"
                ]
              }
            },
            "List_settings": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'OneToOneSettings')"
              },
              "runAfter": {
                "List_action_notices": [
                  "Succeeded"
                ]
              }
            },
            "ActIds": {
              "type": "Compose",
              "inputs": {
                "act": "@first(body('List_actions'))?['Id']",
                "actType": "@first(body('List_actions'))?['ListItemEntityTypeFullName']",
                "upd": "@first(body('List_action_updates'))?['Id']",
                "updRoot": "@first(body('List_action_updates'))?['RootFolder']?['ServerRelativeUrl']",
                "notc": "@first(body('List_action_notices'))?['Id']",
                "notcType": "@first(body('List_action_notices'))?['ListItemEntityTypeFullName']",
                "settings": "@first(body('List_settings'))?['Id']"
              },
              "runAfter": {
                "List_settings": [
                  "Succeeded"
                ]
              }
            },
            "Tracker_ready": {
              "type": "If",
              "expression": "@or(equals(outputs('ActIds')?['act'], null), equals(outputs('ActIds')?['notc'], null))",
              "actions": {
                "Run_setup_first": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "ESG1to1",
                      "message": "The 1-to-1 action lists were not found. Run ESG 1-to-1 | 0 Setup (1.5)."
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "ActIds": [
                  "Succeeded"
                ]
              }
            },
            "Get_notice": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['notc']}')/items(@{triggerBody()?['ID']})?$select=Id,Kind,NoticeKey,ActionId,Status,Attempts",
                  "parameters/headers": {
                    "Accept": "application/json;odata=minimalmetadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Tracker_ready": [
                  "Succeeded"
                ]
              }
            },
            "Still_to_send": {
              "type": "If",
              "expression": "@contains(createArray('Pending', 'Retry'), coalesce(body('Get_notice')?['Status'], ''))",
              "actions": {},
              "else": {
                "actions": {
                  "Already_handled": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Cancelled"
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Get_notice": [
                  "Succeeded"
                ]
              }
            },
            "Claim": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['notc']}')/items(@{triggerBody()?['ID']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata",
                    "X-HTTP-Method": "MERGE",
                    "IF-MATCH": "@{body('Get_notice')?['odata.etag']}"
                  },
                  "parameters/body": "{\"Status\":\"Sending\"}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Still_to_send": [
                  "Succeeded"
                ]
              }
            },
            "Get_action": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['act']}')/items(@{first(split(string(coalesce(body('Get_notice')?['ActionId'], '')), '.'))})?$select=Id,Title,Status,Owner,CurrentDue,Technician/Title,Technician/EMail&$expand=Technician",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Claim": [
                  "Succeeded"
                ]
              }
            },
            "Today_uk": {
              "type": "Compose",
              "inputs": "@formatDateTime(convertFromUtc(utcNow(), 'GMT Standard Time'), 'yyyy-MM-dd')",
              "runAfter": {
                "Get_action": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Key_due": {
              "type": "Compose",
              "inputs": "@if(equals(body('Get_notice')?['Kind'], 'E20'), substring(concat('0000000000', string(coalesce(body('Get_notice')?['NoticeKey'], ''))), length(string(coalesce(body('Get_notice')?['NoticeKey'], ''))), 10), outputs('Today_uk'))",
              "runAfter": {
                "Today_uk": [
                  "Succeeded"
                ]
              }
            },
            "Not_needed": {
              "type": "If",
              "expression": "@or(empty(string(coalesce(body('Get_action')?['Id'], ''))), equals(body('Get_action')?['Status'], 'Closed'), and(equals(body('Get_notice')?['Kind'], 'E19'), not(equals(body('Get_action')?['Status'], 'Ready for close-out'))), and(equals(body('Get_notice')?['Kind'], 'E20'), or(not(equals(outputs('Key_due'), if(contains(string(coalesce(body('Get_action')?['CurrentDue'], '')), 'T'), formatDateTime(convertFromUtc(coalesce(body('Get_action')?['CurrentDue'], '2000-01-01T00:00:00Z'), 'GMT Standard Time'), 'yyyy-MM-dd'), coalesce(body('Get_action')?['CurrentDue'], '')))), less(int(concat('0', replace(outputs('Key_due'), '-', ''))), int(replace(outputs('Today_uk'), '-', ''))))))",
              "actions": {
                "Mark_not_needed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['notc']}')/items(@{triggerBody()?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "X-HTTP-Method": "MERGE",
                        "IF-MATCH": "*"
                      },
                      "parameters/body": "{\"Status\":\"Cancelled\",\"LastError\":\"Not sent – no longer needed\"}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                },
                "Done_not_needed": {
                  "type": "Terminate",
                  "inputs": {
                    "runStatus": "Succeeded"
                  },
                  "runAfter": {
                    "Mark_not_needed": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Key_due": [
                  "Succeeded"
                ]
              }
            },
            "Send_and_record": {
              "type": "If",
              "expression": "@equals(1, 1)",
              "actions": {
                "Send": {
                  "type": "If",
                  "expression": "@equals(body('Get_notice')?['Kind'], 'E19')",
                  "actions": {
                    "Send_E19": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                          "emailMessage/Subject": "Close-out requested: @{replace(replace(replace(coalesce(body('Get_action')?['Technician']?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}",
                          "emailMessage/Body": "<p>@{replace(replace(replace(coalesce(body('Get_action')?['Technician']?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')} has asked you to close out this action:</p><p><b>@{replace(replace(replace(coalesce(body('Get_action')?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b></p><p><a href=\"@{concat(concat(if(endsWith(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), '/'), substring(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), 0, sub(length(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), 1)), parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), '/SitePages/OneToOne.aspx'), '?actionId=', first(split(string(coalesce(body('Get_action')?['Id'], '')), '.')))}\"><b>Review it on the Actions page</b></a> – accept, or say why it is not finished yet.</p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs",
                            "outputs"
                          ]
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Send_E20": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_office365",
                            "operationId": "SendEmailV2",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                          },
                          "parameters": {
                            "emailMessage/To": "@body('Get_action')?['Technician']?['EMail']",
                            "emailMessage/Subject": "Action due in 5 working days",
                            "emailMessage/Body": "<p>This action is due on <b>@{formatDateTime(if(contains(string(coalesce(body('Get_action')?['CurrentDue'], '')), 'T'), formatDateTime(convertFromUtc(coalesce(body('Get_action')?['CurrentDue'], '2000-01-01T00:00:00Z'), 'GMT Standard Time'), 'yyyy-MM-dd'), coalesce(body('Get_action')?['CurrentDue'], '')), 'dd-MMM-yyyy')}</b> (in 5 working days):</p><p><b>@{replace(replace(replace(coalesce(body('Get_action')?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b></p><p>Owner: @{if(equals(body('Get_action')?['Owner'], 'Team Leader'), 'Team Leader', replace(replace(replace(coalesce(body('Get_action')?['Technician']?['Title'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'))}. If it is on track, nothing else is needed; if not, add an update or agree a new date.</p><p><a href=\"@{concat(concat(if(endsWith(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), '/'), substring(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)'), 0, sub(length(parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), 1)), parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')), '/SitePages/OneToOne.aspx'), '?actionId=', first(split(string(coalesce(body('Get_action')?['Id'], '')), '.')))}\"><b>Open the action</b></a></p>",
                            "emailMessage/Importance": "Normal",
                            "emailMessage/Cc": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runtimeConfiguration": {
                          "secureData": {
                            "properties": [
                              "inputs",
                              "outputs"
                            ]
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Mark_sent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['notc']}')/items(@{triggerBody()?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "X-HTTP-Method": "MERGE",
                        "IF-MATCH": "*"
                      },
                      "parameters/body": "{\"Status\":\"Sent\",\"SentOn\":\"@{utcNow()}\",\"Attempts\":@{add(coalesce(body('Get_notice')?['Attempts'], 0), 1)},\"LastError\":\"\"}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {
                    "Send": [
                      "Succeeded"
                    ]
                  }
                },
                "Mark_failed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['notc']}')/items(@{triggerBody()?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "X-HTTP-Method": "MERGE",
                        "IF-MATCH": "*"
                      },
