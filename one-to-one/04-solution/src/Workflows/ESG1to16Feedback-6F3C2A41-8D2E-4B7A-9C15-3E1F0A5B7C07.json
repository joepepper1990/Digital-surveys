{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedsharepointonline_1to1"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esg_sharedoffice365_1to1"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ESG 1-to-1 Site URL (esg_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_SiteUrl",
            "description": "Full address of the private 1-to-1 site, e.g. https://<tenant>.sharepoint.com/sites/<site> (no trailing slash)."
          }
        },
        "ESG 1-to-1 Team Leader email (esg_ManagerEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esg_ManagerEmail",
            "description": "The Team Leader's email address. Receives submissions and problem reports."
          }
        }
      },
      "triggers": {
        "When_feedback_is_sent": {
          "type": "OpenApiConnection",
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "conditions": [
            {
              "expression": "@and(empty(triggerBody()?['SentOn']), equals(coalesce(triggerBody()?['DeliveryStatus']?['Value'], 'Pending'), 'Pending'))"
            }
          ],
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          },
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
              "table": "1-to-1 Feedback"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Get_owners_group": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/associatedownergroup?$select=Id,Title",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Get_role_definitions": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/roledefinitions?$select=Id,Name,RoleTypeKind",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Get_owners_group": [
                  "Succeeded"
                ]
              }
            },
            "Role_full_control": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['RoleTypeKind'], 5)"
              },
              "runAfter": {
                "Get_role_definitions": [
                  "Succeeded"
                ]
              }
            },
            "Role_edit": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Edit')"
              },
              "runAfter": {
                "Role_full_control": [
                  "Succeeded"
                ]
              }
            },
            "Role_read": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_role_definitions')?['value']",
                "where": "@equals(item()?['Name'], '1-to-1 Read')"
              },
              "runAfter": {
                "Role_edit": [
                  "Succeeded"
                ]
              }
            },
            "Get_lists": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists?$select=Id,Title,RootFolder/Name&$expand=RootFolder",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Role_read": [
                  "Succeeded"
                ]
              }
            },
            "List_monthly_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'MonthlyReviews')"
              },
              "runAfter": {
                "Get_lists": [
                  "Succeeded"
                ]
              }
            },
            "List_manager_reviews": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'ManagerReviews')"
              },
              "runAfter": {
                "List_monthly_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Ids": {
              "type": "Compose",
              "inputs": {
                "owners": "@body('Get_owners_group')?['Id']",
                "fullControl": "@first(body('Role_full_control'))?['Id']",
                "edit": "@first(body('Role_edit'))?['Id']",
                "read": "@first(body('Role_read'))?['Id']",
                "reviewsList": "@first(body('List_monthly_reviews'))?['Id']",
                "mgrList": "@first(body('List_manager_reviews'))?['Id']"
              },
              "runAfter": {
                "List_manager_reviews": [
                  "Succeeded"
                ]
              }
            },
            "Check_setup_has_run": {
              "type": "If",
              "expression": "@or(equals(outputs('Ids')?['owners'], null), equals(outputs('Ids')?['fullControl'], null), equals(outputs('Ids')?['edit'], null), equals(outputs('Ids')?['read'], null), equals(outputs('Ids')?['reviewsList'], null), equals(outputs('Ids')?['mgrList'], null))",
              "actions": {
                "STOP_run_the_setup_flow_first": {
                  "type": "Compose",
                  "inputs": "@int('The 1-to-1 permission levels or Owners group were not found. Run ESG 1-to-1 | 0 Setup first.')",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Ids": [
                  "Succeeded"
                ]
              }
            },
            "List_feedback": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_lists')?['value']",
                "where": "@equals(item()?['RootFolder']?['Name'], 'OneToOneFeedback')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Check_setup_has_run": [
                  "Succeeded"
                ]
              }
            },
            "FbIds": {
              "type": "Compose",
              "inputs": {
                "fbList": "@first(body('List_feedback'))?['Id']"
              },
              "runAfter": {
                "List_feedback": [
                  "Succeeded"
                ]
              }
            },
            "Check_feedback_list": {
              "type": "If",
              "expression": "@equals(outputs('FbIds')?['fbList'], null)",
              "actions": {
                "STOP_run_the_setup_flow_again": {
                  "type": "Compose",
                  "inputs": "@int('The 1-to-1 Feedback list was not found. Run ESG 1-to-1 | 0 Setup again.')",
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "FbIds": [
                  "Succeeded"
                ]
              }
            },
            "Lock_reset": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('FbIds')?['fbList']}')/items(@{triggerBody()?['ID']})/resetroleinheritance",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Check_feedback_list": [
                  "Succeeded"
                ]
              }
            },
            "Lock_break": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('FbIds')?['fbList']}')/items(@{triggerBody()?['ID']})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Lock_reset": [
                  "Succeeded"
                ]
              }
            },
            "Lock_owners": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('FbIds')?['fbList']}')/items(@{triggerBody()?['ID']})/roleassignments/addroleassignment(principalid=@{outputs('Ids')?['owners']},roledefid=@{outputs('Ids')?['fullControl']})",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Lock_break": [
                  "Succeeded"
                ]
              }
            },
            "Send_E13": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                  "emailMessage/Subject": "1-to-1 feedback (@{triggerBody()?['FeedbackType']?['Value']}): @{triggerBody()?['Title']}",
                  "emailMessage/Body": "<p><b>@{replace(replace(replace(coalesce(triggerBody()?['Author']?['DisplayName'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</b> (@{replace(replace(replace(coalesce(triggerBody()?['Author']?['Email'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}) sent this from the 1-to-1 page.</p><table cellpadding=\"4\" style=\"border-collapse:collapse\"><tr><td><b>Type</b></td><td>@{replace(replace(replace(coalesce(triggerBody()?['FeedbackType']?['Value'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</td></tr><tr><td><b>Page</b></td><td>@{replace(replace(replace(coalesce(triggerBody()?['PageName'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')} (version @{replace(replace(replace(coalesce(triggerBody()?['AppVersion'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')})</td></tr><tr><td><b>Sent</b></td><td>@{convertFromUtc(utcNow(), 'GMT Standard Time', 'dd-MMM-yyyy HH:mm')}</td></tr></table><div style=\"white-space:pre-wrap;border-left:3px solid #ccc;padding:6px 10px;margin-top:8px\">@{replace(replace(replace(coalesce(triggerBody()?['Message'], ''), '&', '&amp;'), '<', '&lt;'), '>', '&gt;')}</div><p style=\"color:#666\">Kept in the 1-to-1 Feedback list (Owners only).</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Lock_owners": [
                  "Succeeded"
                ]
              }
            },
            "Stamp_sent": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "table": "1-to-1 Feedback",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/SentOn": "@utcNow()",
                  "item/DeliveryStatus/Value": "Sent"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Send_E13": [
                  "Succeeded"
                ]
              }
            },
            "Mark_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "table": "1-to-1 Feedback",
                  "id": "@triggerBody()?['ID']",
                  "item/Title": "@triggerBody()?['Title']",
                  "item/DeliveryStatus/Value": "Failed"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Send_E13": [
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Send_E13_notice": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                  "emailMessage/Subject": "1-to-1 feedback could not be delivered – please read it in the list",
                  "emailMessage/Body": "<p>A message sent with the 1-to-1 feedback button could not be emailed to you. Open the <b>1-to-1 Feedback</b> list (Site contents), or <b>Needs your attention</b> on the 1-to-1 page, to read it.</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Mark_failed": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "Delivery_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ESG1to1",
                  "message": "The feedback email (E13) could not be sent. The item is marked Failed."
                }
              },
              "runAfter": {
                "Send_E13_notice": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Email_TL_run_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                  "emailMessage/Subject": "1-to-1 system: action needed (ESG 1-to-1 | 6 Feedback)",
                  "emailMessage/Body": "<p>The flow <b>ESG 1-to-1 | 6 Feedback</b> failed. Nothing further was sent for this run.</p><p><a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">Open the failed run</a></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {}
            },
            "Terminate_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ESG1to1",
                  "message": "The Try scope failed. See the failed action in the run history."
                }
              },
              "runAfter": {
                "Email_TL_run_failed": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
