                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Folder_missing": [
                  "Succeeded"
                ]
              }
            },
            "Get_folder_access": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['upd']}')/items(@{variables('varFolderId')})/roleassignments?$expand=Member,RoleDefinitionBindings",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {
                "Get_folder_scope": [
                  "Succeeded"
                ]
              }
            },
            "Folder_grants_others": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_folder_access')?['value']",
                "where": "@not(equals(item()?['PrincipalId'], body('Get_flow_account')?['Id']))"
              },
              "runAfter": {
                "Get_folder_access": [
                  "Succeeded"
                ]
              }
            },
            "Folder_grants": {
              "type": "Select",
              "inputs": {
                "from": "@body('Folder_grants_others')",
                "select": "@concat(string(item()?['PrincipalId']), ':', string(first(item()?['RoleDefinitionBindings'])?['Name']), ':', string(length(item()?['RoleDefinitionBindings'])))"
              },
              "runAfter": {
                "Folder_grants_others": [
                  "Succeeded"
                ]
              }
            },
            "Folder_access_ok": {
              "type": "If",
              "expression": "@and(equals(body('Get_folder_scope')?['HasUniqueRoleAssignments'], true), equals(length(body('Folder_grants')), 2), contains(body('Folder_grants'), concat(string(outputs('Ids')?['owners']), ':', first(body('Role_full_control'))?['Name'], ':1')), contains(body('Folder_grants'), concat(string(outputs('Tech_id')), ':1-to-1 Submit:1')))",
              "actions": {},
              "else": {
                "actions": {
                  "Reset_F": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['upd']}')/items(@{variables('varFolderId')})/resetroleinheritance",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {}
                  },
                  "Break_F": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['upd']}')/items(@{variables('varFolderId')})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {
                      "Reset_F": [
                        "Succeeded"
                      ]
                    }
                  },
                  "AddOwners_F": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['upd']}')/items(@{variables('varFolderId')})/roleassignments/addroleassignment(principalid=@{outputs('Ids')?['owners']},roledefid=@{outputs('Ids')?['fullControl']})",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {
                      "Break_F": [
                        "Succeeded"
                      ]
                    }
                  },
                  "AddTech_F": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "HttpRequest",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                        "parameters/method": "POST",
                        "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['upd']}')/items(@{variables('varFolderId')})/roleassignments/addroleassignment(principalid=@{outputs('Tech_id')},roledefid=@{outputs('Ids')?['submit']})",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata"
                        }
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {
                      "AddOwners_F": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Folder_grants": [
                  "Succeeded"
                ]
              }
            },
            "Shared_changed": {
              "type": "If",
              "expression": "@not(equals(toLower(coalesce(body('Get_action')?['SharedWith'], '')), toLower(coalesce(body('Get_action')?['Technician']?['EMail'], ''))))",
              "actions": {
                "Mark_shared": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('ESG 1-to-1 Site URL (esg_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists(guid'@{outputs('ActIds')?['act']}')/items(@{triggerBody()?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "X-HTTP-Method": "MERGE",
                        "IF-MATCH": "*"
                      },
                      "parameters/body": "{\"SharedWith\":\"@{toLower(body('Get_action')?['Technician']?['EMail'])}\"}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runtimeConfiguration": {
                    "secureData": {
                      "properties": [
                        "inputs",
                        "outputs"
                      ]
                    }
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Folder_access_ok": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Initialize_varFolderId": [
              "Succeeded"
            ]
          }
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Email_TL_run_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('ESG 1-to-1 Team Leader email (esg_ManagerEmail)')",
                  "emailMessage/Subject": "1-to-1 system: action needed (ESG 1-to-1 | 9 Action access)",
                  "emailMessage/Body": "<p>The flow <b>ESG 1-to-1 | 9 Action access</b> failed. Nothing further was sent for this run.</p><p><a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">Open the failed run</a></p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runtimeConfiguration": {
                "secureData": {
                  "properties": [
                    "inputs",
                    "outputs"
                  ]
                }
              },
              "runAfter": {}
            },
            "Terminate_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "ESG1to1",
                  "message": "The Try scope failed. See the failed action in the run history."
                }
              },
              "runAfter": {
                "Email_TL_run_failed": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    }
  },
  "schemaVersion": "1.0.0.0"
}
