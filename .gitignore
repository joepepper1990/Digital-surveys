# Toolchain is reproducible via tools/bootstrap.sh — never commit ~200 MB of it.
tools/.toolchain/

# Extraction artefacts. source-working/solution/ is regenerated by unpack.sh
# from the immutable artefact in source-original/. source-working/canvas/ is
# tracked from 1.1.0.6 onward: it carries the corrections, and without it the
# release cannot be reproduced or reviewed as a diff.
source-working/solution/
source-working/manifest.json
source-working/msapp-raw/

# Build output. The released ZIP is attached to the build record, not the repo.
outputs/*.zip
outputs/*.msapp

__pycache__/
*.pyc
.pytest_cache/
.venv/

# Baseline artefacts are supplied to the build, not stored in Git.
source-original/*.zip
