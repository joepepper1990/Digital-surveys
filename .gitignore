# Toolchain is reproducible via tools/bootstrap.sh — never commit ~200 MB of it.
tools/.toolchain/

# Extraction artefacts. source-working/ is regenerated by tools/unpack.sh from
# the immutable artefact in source-original/, so only tracked deliberately.
source-working/solution/
source-working/canvas/
source-working/manifest.json

# Build output. The released ZIP is attached to the build record, not the repo.
outputs/*.zip
outputs/*.msapp

__pycache__/
*.pyc
.pytest_cache/
.venv/
